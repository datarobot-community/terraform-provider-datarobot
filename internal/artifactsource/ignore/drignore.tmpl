# DataRobot source ignore patterns (gitignore syntax)
#
# .datarobot.yaml is never uploaded (hardcoded system exclude, not listed
# here). Edit this file to add or remove rules.

# Python artifacts
__pycache__
*.pyc
*.pyo
.venv
venv
*.egg-info

# Environment / secrets
.env
.env.*

# Build artifacts
dist
build
node_modules

# IDE / OS
.DS_Store
.idea
.vscode

# Tool caches
.mypy_cache
.pytest_cache
.ruff_cache

# Terraform: source.dir can be the directory holding the configuration that
# declares it. State files and the provider cache are system excludes; these
# are the rest, and tfvars in particular tend to hold credentials.
*.tfvars
*.tfvars.json
.terraform.lock.hcl
.terraform.tfstate.lock.info

# Conflict copies (auto-generated by sync — DO NOT REMOVE)
*.LOCAL.*
